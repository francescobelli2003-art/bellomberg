{
  "name": "bellomberg",
  "version": "0.8.0",
  "description": "Bellomberg - Personal AI Hedge Fund Terminal",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:bundles && electron-builder",
    "build:bundles": "tsc && vite build",
    "test:release": "node tests/desktop/contratti.cjs && node --test tests/desktop/darwin.cjs && npm run test:product && npm run test:i18n",
    "test:i18n": "node --test tests/i18n/*.test.cjs",
    "test:product": "node --test tests/product/navigation-chat.cjs tests/product/vol-download.cjs tests/product/trade-entry.cjs tests/product/vol-atlas.cjs",
    "desktop:install": "install-electron",
    "test:desktop": "node tests/desktop/desktop.cjs && node tests/desktop/trade.cjs && node tests/desktop/f18.cjs && node tests/desktop/f13.cjs",
    "electron:dev": "vite",
    "preview": "vite preview"
  },
  "author": "Bellomberg contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "8.2.2",
    "vite-plugin-electron": "1.1.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.bellomberg.app",
    "productName": "Bellomberg",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
