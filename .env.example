# BELLOMBERG — configurazione.
# Copia questo file in `.env` (stessa cartella) e riempi i valori che ti servono.
# Il file .env NON va mai committato (.gitignore lo esclude).
# Le chiavi assenti NON bloccano l'avvio: il backend parte e ogni pannello risponde.
# Stato al 05/09/2026, MISURATO su un clone pulito senza chiavi (scripts/collaudo_sconosciuto.py,
# 71 endpoint GET): PIN assente = login 503 dichiarato; FRED, Polygon, Finnhub (intel), il
# comitato e le analitiche di portafoglio rispondono con un errore o un avviso DICHIARATO;
# le news per ticker, il feed news (NewsAPI, Marketaux, TheNewsAPI, GNews, Tiingo) e il
# calendario IPO (Finnhub) invece TACCIONO: zero elementi e nessun avviso in pagina; l'invio
# email tace per costruzione (solo una riga di log). Il contatto SEC assente ferma i filing
# insider con un errore 500 che porta il motivo, non con un avviso: e' registrato come difetto.
# Piani e limiti dei fornitori citati sotto: come risultavano dai loro siti al 02/09,
# NON verificati dal codice — controlla il tuo piano.
# Chi legge cosa: config.py (la maggior parte), bellomberg_api.py (PIN), sec_edgar.py /
# esef.py (contatto), memory_db.py (cartella dati), consigliere_multi.py e
# specialists/base.py (tuning), news_aggregator.py / finnhub_news.py / polygon_data.py /
# tiingo_news.py / quiver_data.py (le chiavi delle rispettive fonti, lette anche standalone).

# ===== ESSENZIALI =====
# Senza OPENROUTER_API_KEY niente comitato, chat, briefing, memo, classificazione news:
# il backend parte lo stesso e ogni pannello risponde con errore. Senza PIN il login
# e' bloccato (503).
# OpenRouter: openrouter.ai -> Settings -> Keys. Dal 05/09 il prodotto chiama SOLO OpenRouter
# (llm_client.py), con un modello per funzione: v. il blocco MODELLI OPENROUTER in coda.
OPENROUTER_API_KEY=
# Anthropic, FACOLTATIVA dal 05/09: la leggono solo due script laterali non migrati
# (prova_vincoli_pm.py conta i token con count_tokens; mockup_f3_chat/titles_haiku.py).
ANTHROPIC_API_KEY=
# PIN di login: esattamente quattro cifre ASCII (0-9), verificate dal backend.
# Vuoto, malformato o uguale a 1234: login bloccato con errore 503 dichiarato.
BELLOMBERG_PIN=

# ===== OPZIONALI — ogni chiave assente spegne SOLO la sua fonte =====
# Contatto che SEC (EDGAR) e filings.xbrl.org (ESEF) vogliono nello User-Agent: qualsiasi
# email valida (la SEC la usa solo per contattarti in caso di abuso). Senza: filing, insider,
# 13F e bilanci europei rispondono «SEC_CONTACT_EMAIL assente».
SEC_CONTACT_EMAIL=
# Nome con cui il Capo e i prompt si rivolgono a te, e footer dei PDF. Vuoto = "PM".
PM_NAME=PM
# Cartella dati: DB SQLite, ChromaDB, backup, log, heartbeat degli agenti, rescue dei
# memo e cache dei moduli. Vuoto = <progetto>/data. Un percorso relativo viene
# risolto rispetto alla radice del progetto da bellomberg.core.paths.
# I log Windows restano in data/ della radice; il backup usa questa cartella anche per il log.
BELLOMBERG_DATA_DIR=
# Radice runtime per installazioni del package fuori dal checkout. Nel checkout
# viene riconosciuta dal pyproject.toml; fuori dal checkout va impostata prima
# dell'avvio (variabile d'ambiente, necessaria per trovare anche questo .env).
BELLOMBERG_PROJECT_ROOT=
# Cartella dei report generati. Vuoto = <progetto>/report; path relativi al progetto.
BELLOMBERG_REPORT_DIR=
# Cartella delle note di ricerca. Vuoto = <progetto>/research_notes.
BELLOMBERG_RESEARCH_NOTES_DIR=
# NewsAPI: newsapi.org/register. Feed news di base. Senza: la fonte tace (oggi senza avviso).
NEWS_API_KEY=
# News multi-fonte del feed: marketaux.com · thenewsapi.com · gnews.io.
# Senza: ognuna tace (oggi senza avviso).
MARKETAUX_API_KEY=
THENEWSAPI_API_KEY=
GNEWS_API_KEY=
# Ricerca web del comitato: tavily.com. Senza: il tool di ricerca risponde con errore dichiarato.
TAVILY_API_KEY=
# Dati macro da FRED (fred.stlouisfed.org/docs/api/api_key.html): curva Treasury, spread HY
# (proxy iTraxx), 10Y IT/FR/DE, indicatori. Senza: errore dichiarato nel pannello macro.
FRED_API_KEY=
# Finnhub (finnhub.io): news, calendario earnings, insider Form 4, calendario IPO.
# Senza: news/earnings/insider dichiarano il buco; il calendario IPO tace (oggi).
FINNHUB_API_KEY=
# Invio del briefing via Gmail. EMAIL_PASSWORD e' una APP PASSWORD
# (myaccount.google.com/apppasswords), NON la password dell'account. Senza: nessun invio,
# solo una riga di log.
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
# Opzioni (catene, volatilita' implicita, GEX): polygon.io. Solo per le opzioni.
# Senza: summary/GEX/IV dichiarano il buco; catene e scadenze dalla chat rispondono «no data».
POLYGON_API_KEY=
# News alternative: tiingo.com. Senza: la fonte tace (oggi senza avviso).
TIINGO_API_KEY=
# Trade del Congresso USA, lobbying e contratti federali: quiverquant.com.
# Senza: errore dichiarato nel tool.
QUIVER_API_KEY=

# ===== TUNING — lascia il valore o CANCELLA la riga: vuoto NON vale default =====
# Specialisti in parallelo nel comitato (consigliere_multi.py).
CONSIGLIERE_PARALLEL=4

# ===== MODELLI OPENROUTER (05/09, tabella del PM) — lascia il valore o cambialo: VUOTO = errore col nome =====
# Ogni funzione ha il suo modello: uno slug `provider/modello` del catalogo openrouter.ai/models,
# letto da llm_client.py a ogni chiamata. Variabile assente o vuota = quella funzione si ferma
# con «X assente nel .env», mai un ripiego su un altro modello. Prezzi e disponibilita' li
# dice il catalogo, non questo file.
# Default di tutte le chat F3; gli override per agente qui sotto hanno precedenza.
CHAT_MODEL=z-ai/glm-5.3-flash
# Tetto per singola chiamata chat, ragionamento incluso (intero).
CHAT_MAX_TOKENS=24000
# Modello chat per ciascun agente attivo (sostituisce CHAT_MODEL per quell'agente).
CHAT_CAPO_MODEL=google/gemini-3.8-flash
CHAT_MACRO_MODEL=z-ai/glm-5.3-flash
CHAT_QUANT_MODEL=z-ai/glm-5.3-flash
CHAT_OPTIONS_MODEL=z-ai/glm-5.3-flash
CHAT_FUNDAMENTALS_MODEL=z-ai/glm-5.3-flash
CHAT_CRYPTO_MODEL=deepseek/deepseek-v4-flash-0731
CHAT_EVENTDESK_MODEL=z-ai/glm-5.3-flash
# Modello delle vecchie sessioni chat (news/politics), consultabili ma non nel desk attivo.
CHAT_POLITICS_MODEL=z-ai/glm-5.3-flash
CHAT_NEWS_MODEL=z-ai/glm-5.3-flash
# Generazione del briefing (briefing_engine.py) e classificazione degli articoli del feed
# news (news_aggregator.py).
BRIEFING_MODEL=z-ai/glm-5.3-flash
NEWS_CLASSIFIER_MODEL=deepseek/deepseek-v4-flash-0731
# Default dei desk del consigliere nei round R1/R2, e modello del ricognitore R0
# (specialists/base.py; ripipeline 15/07: il round 0 e' raccolta dati).
# 13/09: comitato su google/gemini-3.8-flash, scelta del PM (la seconda run del 10/09 gira
# gia' su questo modello; nella prima quattro call su z-ai/glm-5.3 uscirono a 0 caratteri).
CONSIGLIERE_MODEL=google/gemini-3.8-flash
CONSIGLIERE_R0_MODEL=google/gemini-3.8-flash
# Override R1/R2 per ciascun desk (sostituisce CONSIGLIERE_MODEL per quel desk).
CONSIGLIERE_MACRO_MODEL=google/gemini-3.8-flash
CONSIGLIERE_QUANT_MODEL=google/gemini-3.8-flash
CONSIGLIERE_OPTIONS_MODEL=google/gemini-3.8-flash
CONSIGLIERE_FUNDAMENTALS_MODEL=google/gemini-3.8-flash
CONSIGLIERE_CRYPTO_MODEL=deepseek/deepseek-v4-flash-0731
CONSIGLIERE_EVENTDESK_MODEL=google/gemini-3.8-flash
# Sintesi finale del Capo (capo.py).
CAPO_MODEL=anthropic/claude-opus-5
# Critica avversariale (red_team.py), lezione post-run (reflection.py) ed estrazione
# strutturata delle azioni (action_table_extract.py; `:exacto` = variante OpenRouter che
# preferisce i provider piu' affidabili sul tool calling).
# 11/09: il modello precedente (meta/muse-spark-1.3) e' dietro un gate di attestazione
# 18+ su OpenRouter -> HTTP 403 e red team saltato nella run del 10/09 (memo #53).
RED_TEAM_MODEL=google/gemini-3.8-flash
REFLECTION_MODEL=deepseek/deepseek-v4-flash-0731
ACTION_EXTRACTOR_MODEL=deepseek/deepseek-v4-flash-0731:exacto
